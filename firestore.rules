rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Help Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'email', 'level', 'xp', 'gold', 
          'selectedCompanion', 'activeTheme', 'ownedThemes', 
          'avatarId', 'ownedAvatars', 'title', 'ownedTitles', 'stats', 'createdAt'
        ])
      );

      function isValidUser(data) {
        return data.email is string && data.email.size() > 0 && data.email.size() < 256
          && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
          && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
      }

      // 2. Tasks Subcollection
      match /tasks/{taskId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(taskId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(taskId) && (
          // Action: Toggle completion
          (incoming().diff(existing()).affectedKeys().hasOnly(['completed']) && incoming().completed is bool) ||
          // Action: Edit task / RPG categories
          (incoming().diff(existing()).affectedKeys().hasOnly(['text', 'priority', 'dueDate', 'category', 'difficulty', 'subTasks', 'notes']) && isValidTask(incoming(), userId))
        );
        allow delete: if isOwner(userId) && isValidId(taskId);
      }
    }

    function isValidTask(data, userId) {
      return data.userId == userId
        && data.text is string && data.text.size() > 0 && data.text.size() <= 500
        && data.completed is bool
        && data.priority in ['low', 'medium', 'high']
        && (!('createdAt' in data) || data.createdAt is int)
        && data.dueDate is string && data.dueDate.size() > 0
        && data.category in ['study', 'fitness', 'chores', 'creative', 'routine']
        && data.difficulty in ['D', 'C', 'B', 'A', 'S']
        && (!('notes' in data) || data.notes is string)
        && (!('subTasks' in data) || data.subTasks is list);
    }
  }
}
