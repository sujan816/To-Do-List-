{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A to-do task",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "category": { "type": "string", "enum": ["study", "fitness", "chores", "creative", "routine"] },
        "difficulty": { "type": "string", "enum": ["D", "C", "B", "A", "S"] },
        "userId": { "type": "string" }
      },
      "required": ["text", "completed", "createdAt", "priority", "category", "difficulty", "dueDate", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "The user document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "A task belonging to a specific user"
    }
  }
}
